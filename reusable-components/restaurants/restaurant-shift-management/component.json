{
  "id": "restaurant-shift-management",
  "name": "Restaurant Shift Management",
  "industry": "restaurants",
  "version": "0.1.0",
  "stability": "experimental",
  "oneLiner": "Staff shifts, work schedules, shift notes, and handoff information.",
  "dependencies": [
    "@business-os/shared"
  ],
  "permissions": [
    "restaurant.shifts.manage",
    "restaurant.shifts.read"
  ],
  "configOptions": [
    {
      "key": "minShiftNoticeMinutes",
      "type": "number",
      "default": "60",
      "description": "Minimum notice for shift changes."
    }
  ],
  "sensitive": false,
  "entityTypes": [
    "Shift"
  ],
  "operations": [
    {
      "name": "createShift",
      "permission": "restaurant.shifts.manage",
      "description": "Schedule a new shift.",
      "auditAction": "restaurant.shift.created"
    },
    {
      "name": "addHandoffNotes",
      "permission": "restaurant.shifts.manage",
      "description": "Append handoff notes to a shift, for the next shift to read.",
      "auditAction": "restaurant.shift.handoff_added"
    }
  ]
}
