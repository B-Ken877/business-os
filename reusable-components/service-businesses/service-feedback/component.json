{
  "id": "service-feedback",
  "name": "Service Feedback",
  "industry": "service-businesses",
  "version": "0.1.0",
  "stability": "experimental",
  "oneLiner": "Customer feedback, ratings, and issue tracking.",
  "dependencies": [
    "@business-os/shared",
    "service-booking"
  ],
  "permissions": [
    "service.feedback.create",
    "service.feedback.read",
    "service.feedback.respond"
  ],
  "configOptions": [
    {
      "key": "minRatingForGood",
      "type": "number",
      "default": "4",
      "description": "Rating threshold for 'good' feedback."
    }
  ],
  "sensitive": false,
  "entityTypes": [
    "Feedback"
  ],
  "operations": [
    {
      "name": "submitFeedback",
      "permission": "service.feedback.create",
      "description": "Submit feedback for a booking.",
      "auditAction": "service.feedback.submitted"
    },
    {
      "name": "listNeedsFollowUp",
      "permission": "service.feedback.read",
      "description": "List all feedback that needs follow-up (low ratings).",
      "auditAction": ""
    }
  ]
}
