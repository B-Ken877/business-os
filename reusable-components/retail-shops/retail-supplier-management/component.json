{
  "id": "retail-supplier-management",
  "name": "Retail Supplier Management",
  "industry": "retail-shops",
  "version": "0.1.0",
  "stability": "experimental",
  "oneLiner": "Suppliers, purchase history, restocking, and supplier contact records.",
  "dependencies": [
    "@business-os/shared"
  ],
  "permissions": [
    "retail.suppliers.manage",
    "retail.suppliers.read",
    "retail.purchaseorders.create",
    "retail.purchaseorders.receive"
  ],
  "configOptions": [
    {
      "key": "defaultPaymentTermsDays",
      "type": "number",
      "default": "30",
      "description": "Default payment terms (days)."
    }
  ],
  "sensitive": true,
  "entityTypes": [
    "Supplier",
    "PurchaseOrder"
  ],
  "operations": [
    {
      "name": "createSupplier",
      "permission": "retail.suppliers.manage",
      "description": "Create a new supplier record.",
      "auditAction": "retail.supplier.created"
    },
    {
      "name": "createPurchaseOrder",
      "permission": "retail.purchaseorders.create",
      "description": "Create a new purchase order for a supplier.",
      "auditAction": "retail.po.created"
    },
    {
      "name": "markPurchaseOrderReceived",
      "permission": "retail.purchaseorders.receive",
      "description": "Mark a PO as received. The actual stock increment is delegated to retail-inventory.",
      "auditAction": "retail.po.received"
    }
  ]
}
